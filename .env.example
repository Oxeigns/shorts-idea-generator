# Copy to .env and fill in. Real environment variables override this file.
# Never commit .env — it holds live credentials.

# ---------------------------------------------------------------- Hacker AI
# Idea generation. The key must start with "sk-" and must be an inference key
# bought at https://hackerai.sh/pricing. An "hsb_" bridge token cannot generate.
HACKER_AI_API_KEY=
HACKER_AI_BASE_URL=https://api.hackerai.sh/v1
HACKER_AI_MODEL=auto

# ---------------------------------------------------- HackerAI local bridge
# This is NOT the same as HACKER_AI_API_KEY above. This token (starts with "hsb_")
# authorises the local bridge (`npx @hackerai/local`) that lets HackerAI work on the
# machine it runs on. It is not an inference credential and cannot generate ideas.
# Used by ./bridge.sh only. Never commit a real value.
HACKERAI_BRIDGE_TOKEN=
# Optional: the name HackerAI shows when picking this computer (default: hostname).
# HACKERAI_BRIDGE_NAME="Work PC"

# ---------------------------------------------------------------- ElevenLabs
# Hindi speech synthesis. Your plan must be in good standing (status active or
# trialing) or ElevenLabs refuses text-to-speech with a payment error.
ELEVENLABS_API_KEY=
# Multilingual voices read Hindi. CwhRBWXzGAHq8TQ4Fs17 is Roger (male, American).
ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ----------------------------------------------------------------------- App
# Signs session cookies and derives the Fernet key that encrypts stored API
# keys. Leave blank and the app generates data/secret.key (0600) on first run.
APP_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SESSION_DAYS=7
# Set to 1 only when the app is served over HTTPS.
COOKIE_SECURE=0

# ------------------------------------------------------------------ Optional
# DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/ideas.db
# REQUEST_TIMEOUT=90
# ALLOW_ENV_SECRETS=1

# --------------------------------------------------------------- Security
# Emit CSP, nosniff, Referrer-Policy, X-Frame-Options and Permissions-Policy.
SECURITY_HEADERS=1
# HSTS is sent only on HTTPS requests. Set to 0 if your proxy already adds it.
HSTS=1
# Escape hatch for a LOCAL Hacker AI-compatible gateway only. It allows http://
# and private hostnames for HACKER_AI_BASE_URL, which would otherwise be
# rejected to prevent SSRF. Never enable on a public server.
HACKER_AI_ALLOW_INSECURE_BASE_URL=0
