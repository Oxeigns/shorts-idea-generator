# Copy to .env and fill in. Real environment variables override this file.
# Never commit .env — it holds live credentials.

# ---------------------------------------------------------------- Hacker AI
# Idea generation. The key must start with "sk-" and must be an inference key
# bought at https://hackerai.sh/pricing. An "hsb_" bridge token cannot generate.
HACKER_AI_API_KEY=
HACKER_AI_BASE_URL=https://api.hackerai.sh/v1
HACKER_AI_MODEL=auto

# ---------------------------------------------------------------- ElevenLabs
# Hindi speech synthesis. Your plan must be in good standing (status active or
# trialing) or ElevenLabs refuses text-to-speech with a payment error.
ELEVENLABS_API_KEY=
# Multilingual voices read Hindi. CwhRBWXzGAHq8TQ4Fs17 is Roger (male, American).
ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ----------------------------------------------------------------------- App
# Signs session cookies and derives the Fernet key that encrypts stored API
# keys. Leave blank and the app generates data/secret.key (0600) on first run.
APP_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SESSION_DAYS=7
# Set to 1 only when the app is served over HTTPS.
COOKIE_SECURE=0

# ------------------------------------------------------------------ Optional
# DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/ideas.db
# REQUEST_TIMEOUT=90
# ALLOW_ENV_SECRETS=1
